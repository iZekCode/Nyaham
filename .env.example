# Copy this file to .env and fill in real values. NEVER commit the real .env.

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Your personal Telegram chat id (used for admin commands + error alerts).
# Get it by messaging @userinfobot, or check bot logs after /start.
ADMIN_CHAT_ID=123456789

# Optional overrides (defaults live in config.py)
# DB_PATH=data/cache.sqlite
# LOG_LEVEL=INFO
# CHART_THEME=dark

# Logging to a rotating file (leave LOG_FILE empty for console-only).
# In Docker these default to /app/logs/bot.log (see deploy/Dockerfile).
# LOG_FILE=logs/bot.log
# LOG_MAX_BYTES=5000000
# LOG_BACKUP_COUNT=5
